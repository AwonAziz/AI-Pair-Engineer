# Required for the four-stage review. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model id. Must support structured JSON output.
MODEL=deepseek/deepseek-chat

# Optional. Override to use a different OpenAI-compatible endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Per-request timeout in seconds.
# OPENROUTER_TIMEOUT=120
